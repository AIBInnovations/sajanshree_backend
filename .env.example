# Copy to .env and fill in real values. Never commit .env.

PORT=5000
MONGO_URI=
JWT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# WhatsApp notifications via Slide (https://slide.synquic.com)
# Leave SLIDE_API_KEY blank until the Meta templates are approved —
# the app runs normally with sending disabled.
SLIDE_API_KEY=
SLIDE_API_BASE_URL=https://slide.synquic.com/api/v1
SLIDE_WHATSAPP_TEMPLATE=order_confirmation
SLIDE_WHATSAPP_TEMPLATE_WITH_VALUE=order_confirmation_with_value
SLIDE_WHATSAPP_INVOICE_TEMPLATE=invoice_notification
SLIDE_WHATSAPP_LANGUAGE=en
SLIDE_TIMEOUT_MS=10000
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_ENABLED=true

# TEST MODE. While set, EVERY WhatsApp message (orders, Tally invoices, cron
# retries) is diverted to this one number instead of the real recipient, so no
# customer can be messaged by accident during testing.
# Format: E.164 without "+", e.g. 919876543210. MUST be blank in production.
WHATSAPP_TEST_REDIRECT_TO=

# TallyPrime integration.
# Shared key presented by the companion service on the shop PC as X-Api-Key.
# This is a machine credential on a till PC — rotate it if that PC is replaced,
# re-imaged, or leaves the premises. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave blank to disable the Tally endpoint entirely (it fails closed with 503).
TALLY_API_KEY=
